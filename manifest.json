{
  "manifest_version": 3,
  "name": "Business Scam Detector",
  "version": "1.0",
  "description": "Detect potential scams by showing reviews, complaints, and license checks when searching.",
  "permissions": [ "activeTab", "storage" ],
  "host_permissions": [ "https://*/*" ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [ "*://www.google.com/*" ],
      "js": [ "content.js" ],
      "css": [ "content.css", "warningSummaryStyle.css", "scamCheckBox.css" ]
    }
  ]
}